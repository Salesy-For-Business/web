# =============================================================================
# Salesy — environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# Public site URL (no trailing slash). Used for share links, redirects, webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database — MongoDB
# Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/salesy?retryWrites=true&w=majority
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Server-only signing secret for sessions / JWTs (long random string).
AUTH_SECRET=

# Optional Google sign-in (leave blank to keep mock Google until OAuth is wired).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Payments + bank list / NUBAN resolve — Paystack
# Dashboard: https://dashboard.paystack.com/#/settings/developer
# Secret stays server-only (also powers /api/banks). Public key is browser-safe.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# File uploads — Cloudinary (logos, products, Grow Biz creative)
# Dashboard: https://console.cloudinary.com
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder prefix in your Cloudinary media library
CLOUDINARY_FOLDER=salesy

# -----------------------------------------------------------------------------
# Transactional email — Brevo (Sendinblue)
# Dashboard: https://app.brevo.com/settings/keys/api
# -----------------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM=Salesy <noreply@salesy.link>
