# =============================================================================
# Salesy — environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# Public site URL (no trailing slash). Used for share links, redirects, webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database — MongoDB
# Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/salesy?retryWrites=true&w=majority
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Server-only signing secret for sessions / JWTs (long random string).
AUTH_SECRET=

# Optional Google sign-in (leave blank to hide the "unavailable" fallback
# on the Google button and disable the /api/auth/google/* routes).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application) → Authorized redirect URIs (NOT "Authorized JavaScript
# origins" — that's a different field and won't work here). Add the exact
# full path for every environment you use, e.g. both:
#   http://localhost:3000/api/auth/google/callback
#   https://salesy.link/api/auth/google/callback
# The app derives the redirect_uri it sends Google from the incoming
# request's own origin, so whichever one you're on is used automatically —
# as long as its exact URI (path included) is registered above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only set this if the redirect_uri must be something other than
# {request origin}/api/auth/google/callback (e.g. behind a proxy that
# changes the origin Next.js sees).
GOOGLE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Payments + bank list / NUBAN resolve — Paystack
# Dashboard: https://dashboard.paystack.com/#/settings/developer
# Secret stays server-only (also powers /api/banks). Public key is browser-safe.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
# Required in production — the webhook rejects all events if this is unset,
# since it's what grants/revokes paid-plan access and split percentages.
PAYSTACK_WEBHOOK_SECRET=

# Recurring-billing Plan codes — one per (tier, currency). Create these once
# in the Paystack dashboard (or via the createPlan() helper in a one-off
# script), then paste the resulting plan_code here. A tier/currency with no
# code set is simply unavailable to upgrade into (see lib/plan-codes.ts).
PAYSTACK_PLAN_BOUTIQUE_NGN=
PAYSTACK_PLAN_BOUTIQUE_GHS=
PAYSTACK_PLAN_BOUTIQUE_ZAR=
PAYSTACK_PLAN_BOUTIQUE_KES=
PAYSTACK_PLAN_PRO_NGN=
PAYSTACK_PLAN_PRO_GHS=
PAYSTACK_PLAN_PRO_ZAR=
PAYSTACK_PLAN_PRO_KES=

# Optional — checked by /api/cron/subscription-reminders so only Vercel's
# own cron trigger (or you, manually, for testing) can invoke it. Leave
# blank locally; Vercel sets its own cron auth automatically in production
# but setting this too adds defense in depth.
CRON_SECRET=

# -----------------------------------------------------------------------------
# File uploads — Cloudinary (logos, products, Grow Biz creative)
# Dashboard: https://console.cloudinary.com
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder prefix in your Cloudinary media library
CLOUDINARY_FOLDER=salesy

# -----------------------------------------------------------------------------
# Transactional email — Brevo (Sendinblue)
# Dashboard: https://app.brevo.com/settings/keys/api
# -----------------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM=Salesy <noreply@salesy.link>
